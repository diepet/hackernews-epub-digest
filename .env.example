# Copy to .env and load with: uv run --env-file .env python main.py --dry-run
LLM_MODEL=gemini/gemma-3-27b-it
GEMINI_API_KEY=
TARGET_LANGUAGE=English
STORY_LIMIT=10
# Set these to your provider/account limits. Zero disables that local limit.
LLM_RPM_LIMIT=0
LLM_TPM_LIMIT=0
LLM_MAX_OUTPUT_TOKENS=1800
LLM_MAX_WAIT_SECONDS=300

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
PUBLISH_EMAIL=
